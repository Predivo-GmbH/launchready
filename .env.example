# Frontend (baked into static build)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sentry error monitoring (client-only; static export has no server/edge runtime)
NEXT_PUBLIC_SENTRY_DSN=https://your-key@oXXXXXX.ingest.de.sentry.io/XXXXXXX
# Source-map upload at build time only (not baked into the client bundle):
# SENTRY_ORG=predivo-gmbh
# SENTRY_PROJECT=launchready
# SENTRY_AUTH_TOKEN=sntrys_...

# Edge Function secrets (set via: supabase secrets set KEY=value)
# ANTHROPIC_API_KEY=sk-ant-...
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
